<Window x:Class="SpacesBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пространства"
        Width="1120" Height="760"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Grid Margin="34,16,34,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource Primary}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="25" FontWeight="Bold" Text="П" />
            </Border>
            <StackPanel Grid.Column="1" Margin="15,1,0,0">
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="Пространства" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"
                           Text="Изолированные браузерные профили" />
            </StackPanel>
            <Border Grid.Column="2" Width="310" Padding="13,9" CornerRadius="13"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   Text="ПУБЛИЧНЫЙ IPv4" />
                        <TextBlock x:Name="PublicIpText" Margin="0,2,0,0"
                                   FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                   Text="Проверяем…" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PublicIpChangeText" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   Text="Первая проверка" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshIpButton" Margin="12,0,0,0"
                            Width="38" Height="38" Padding="0"
                            Style="{StaticResource RoundedButton}"
                            Click="RefreshIp_Click" ToolTip="Проверить IP ещё раз"
                            FontSize="18" Content="↻" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" x:Name="BrowserBanner"
                Margin="34,0,34,0" Padding="18,13"
                CornerRadius="13" BorderThickness="1"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="BrowserStatusDot" Width="10" Height="10" Fill="#FFB44C" Margin="0,0,11,0" />
                    <StackPanel>
                        <TextBlock x:Name="BrowserStatusTitle" FontWeight="SemiBold" Text="Поиск браузера…" />
                        <TextBlock x:Name="BrowserStatusDetails" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="DownloadBraveButton"
                        Style="{StaticResource RoundedButton}" Padding="13,8" Margin="10,0"
                        Click="DownloadBrave_Click">Установить Brave автоматически</Button>
                <Button Grid.Column="2" Style="{StaticResource RoundedButton}" Padding="13,8"
                        Click="ChooseBrowser_Click">Выбрать браузер</Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="34,16,34,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PrimaryButton}" Click="CreateProfile_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="18" Margin="0,-2,8,0" Text="＋" />
                    <TextBlock Text="Новое пространство" />
                </StackPanel>
            </Button>
            <Grid Grid.Column="2" Width="230" Height="38" Margin="0,0,10,0">
                <Border CornerRadius="10" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="{StaticResource TextSecondary}" Text="&#xE721;" />
                <TextBlock x:Name="SearchHint" Margin="36,0,30,0" VerticalAlignment="Center"
                           Foreground="#77839A" IsHitTestVisible="False" Text="Найти пространство" />
                <TextBox x:Name="SearchBox" Margin="32,1,31,1" Padding="5,0" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" TextChanged="Search_Changed" />
                <Button x:Name="SearchClearButton" Width="28" Height="28" Margin="0,0,5,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                        Visibility="Collapsed" Style="{StaticResource RoundedButton}"
                        FontSize="15" Content="×" ToolTip="Очистить поиск" Click="SearchClear_Click" />
            </Grid>
            <Button Grid.Column="3" x:Name="BackToFoldersButton" Margin="0,0,10,0" Padding="13,8"
                    Style="{StaticResource RoundedButton}" Click="BackToFolders_Click" Content="← Папки" />
            <Button Grid.Column="4" Padding="13,8" Style="{StaticResource RoundedButton}"
                    Click="AllProfiles_Click" Content="Все пространства" />
        </Grid>

        <ScrollViewer Grid.Row="3" x:Name="ProfilesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,6,20,24">
                <TextBlock x:Name="ActiveHeading" Margin="2,0,0,13" FontSize="16" FontWeight="SemiBold" Text="Папки" />
                <WrapPanel x:Name="FoldersPanel" />
                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Padding="38" Margin="0,8,14,0" CornerRadius="16"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="38" Foreground="{StaticResource Primary}" Text="◎" />
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   FontSize="19" FontWeight="SemiBold" Text="В этой папке пока пусто" />
                        <TextBlock HorizontalAlignment="Center" Margin="0,7,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Выберите другую папку или создайте новое пространство." />
                    </StackPanel>
                </Border>

                <WrapPanel x:Name="ActiveProfilesPanel" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Background="#0E1118" BorderBrush="#202633" BorderThickness="0,1,0,0">
            <Grid Margin="34,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           Text="Готово" />
                <Button Grid.Column="1" x:Name="UpdateButton" VerticalAlignment="Center"
                        Style="{StaticResource RoundedButton}" FontSize="12" Padding="10,4"
                        Click="UpdateButton_Click" Content="Проверить обновления" />
            </Grid>
        </Border>
    </Grid>
</Window>
